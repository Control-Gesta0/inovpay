{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/inbound.ts": {
      "maxDuration": 300,
      "includeFiles": "prompts/**"
    },
    "api/validate.ts": {
      "maxDuration": 60,
      "includeFiles": "prompts/**"
    },
    "api/reset.ts": {
      "maxDuration": 60
    },
    "api/executions.ts": {
      "maxDuration": 30
    },
    "api/central.ts": {
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/painel",
      "destination": "https://central-inovpay.vercel.app",
      "permanent": false
    },
    {
      "source": "/",
      "destination": "https://central-inovpay.vercel.app",
      "permanent": false
    }
  ]
}
