# Copie para .env.local (nunca commite valores reais)
GHL_TOKEN=pit-...
GHL_LOCATION_ID=
OPENAI_API_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIS_PREFIX=agente-inovpay:
WEBHOOK_SECRET=            # openssl rand -hex 24 (novo, só deste cliente)
CLIENT_NAME=InovPay · Agente
GATE_TAG=ia                # só atende contato com esta tag
HUMAN_TAG=atendimento-humano
MODO_GATE=tag              # tag | todos | desligada
RESET_PHONES=              # telefones que podem mandar "reset" (separados por vírgula)
TEST_CONTACT_IDS=          # ou ids de contato do GHL
LLM_MODEL=gpt-5.4-mini-2026-03-17
CENTRAL_SECRET=            # openssl rand -hex 32 · o mesmo valor vai no AGENT_SECRET da Central
COST_USD_BRL=5.4           # cotação para mostrar o custo do modelo em reais na Central
